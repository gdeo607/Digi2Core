{
 "elemod": 2,
 "id": "core",
 "version": "2.6.1",
 "title": "core",
 "description": "The boot copier and the hook bus for the Digitakt II (core 1.0), and the frameworks mods build on: added machine types (core_machines), added parameters (core_params), knob drawers (core_knobs), the pattern service (core_trig_*, core_plock_*), and on the DSP the in-renderer voice hook (DigiKit's core/machines, core/params and core/dsp-inline) with the tables mods add to. On its own it changes nothing the unit does.",
 "category": "Framework",
 "author": "irpina (core 1.0), Em D (DigiKit frameworks); core 2.0 port",
 "license": "AGPL-3.0-or-later",
